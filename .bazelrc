# Write build outputs in a platform-specific directory;
# avoid outputs being wiped and rewritten when switching between platforms.
common --experimental_platform_in_output_dir
common --enable_platform_specific_config
# Use a symlink prefix to avoid clobbering the workspace root.
build --symlink_prefix=.bazel/
# @pypi packages from [project] dependencies (implicit venv = project name).
# Not a `common` flag: evaluating @pypi fetches aspect_rules_py's uv host,
# which fail()s on Windows (`Unsupported platform windows`).
common:linux --@pypi//venv=scheda
common:macos --@pypi//venv=scheda
# The Python version of `python.defaults` in `python.MODULE.bazel`; keep the
# two equal. A `py_binary` of aspect_rules_py sets this flag on itself and
# everything below it, so while it is unset everywhere else, the Rust CLI in
# the `data` of `//python/cli` builds a second time, in a `-ST-` directory.
common:linux --@aspect_rules_py//py:python_version=3.14
common:macos --@aspect_rules_py//py:python_version=3.14
# rules_rust tests need runfiles; Windows defaults this off.
common --enable_runfiles
# The crates of `@scheda_cargo` build with optimizations in every
# compilation mode, as Cargo's `[profile.dev.package."*"]` does in
# `Cargo.toml`; the workspace's own crates keep the mode's. Unoptimized,
# Lance trains a vector index many times slower: the volume tests of
# `//rust/scheda:integration_test` outran their waits on a CI runner.
common --@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+scheda_cargo__@-Copt-level=2
# rules_cc asks link.exe whether it supports /DEBUG:FASTLINK by reading its
# help, which Visual Studio 2026 still prints although the linker dropped
# the flag (LNK4315 on every link). The fastbuild feature only adds that
# flag, and /Od /Z7 for C, which here only the build scripts of crates
# compile.
build:windows --features=-fastbuild
# cl.exe and link.exe read no path past MAX_PATH (260), long paths enabled
# or not. On Windows the target platform is the host under a short name
# (`//bazel:host`), so outputs go to `bazel-out/w-fastbuild` instead of
# `bazel-out/x64_windows-fastbuild`: zstd-sys's C sources came within two
# characters of the limit, and a doc test's standard library past it.
common:windows --platforms=//bazel:host
common:windows --experimental_override_name_platform_in_output_dir=//bazel:host=w
# Nothing in the build compiles protoc or the protobuf C++ library: a target
# that reaches `@protobuf//:protoc` or a C++ compile of module `protobuf`
# fails its build (`bazel/no_protobuf_source.bzl`).
build --aspects=//bazel:no_protobuf_source.bzl%no_protobuf_source
build --output_groups=+no_protobuf_source
# Host `git` on PATH. Scheda invokes the system git executable.
# Do not inherit HOME: Bazel already gives tests a scratch home, and the
# developer's ~/.gitconfig must not change outcomes. Empty GIT_CONFIG_*
# paths disable global and system git config for the test process only.
test --test_env=PATH
test --test_env=GIT_CONFIG_NOSYSTEM=1
test --test_env=GIT_CONFIG_GLOBAL=
test --test_env=GIT_CONFIG_SYSTEM=
# uv.lock is Linux-only (vLLM manylinux). `//python/cli` would compile
# hf_xet / PyYAML sdists (`No module named build`). Keep //python for ruff.
common:macos --deleted_packages=python/cli,python/vllm
# `target_compatible_with` does not stop `//...` from loading these packages.
# Deleted, they are invisible, so the uv host is not fetched.
common:windows --deleted_packages=python,python/cli,python/vllm
# Test Vaults on tmpfs: each `add` fsyncs, and on a real disk the 10³
# volume suites spend tens of seconds waiting for flushes and stall the
# rest of the machine. The gate checks behaviour, not disk speed. Not under
# /tmp: linux-sandbox replaces /tmp with a hermetic directory on disk.
test:linux --test_tmpdir=/dev/shm/scheda-bazel-test
# Test sizes follow local run times (small: under ~45 s). A four-core CI
# runner is five to seven times slower, Windows in particular spawns git far
# more slowly, and the Lance volume tests of `//rust/scheda:integration_test`
# take about three minutes there: the short timeout is five times the
# default, the others three times. `medium` for that test would not do:
# Bazel reports a medium test that runs in under 30 s as too big, and
# locally it does.
test --test_timeout=300,900,2700,3600
