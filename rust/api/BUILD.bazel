load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    # Destination of //api:generate.
    "gen",
])

_API_DEPS = [
    "@scheda_cargo//:buffa",
    "@scheda_cargo//:buffa-types",
    "@scheda_cargo//:protocontract",
    "@scheda_cargo//:protovalidate-buffa",
    "@scheda_cargo//:serde",
    "@scheda_cargo//:serde_json",
]

# The generated trees are rustfmt::skip from lib.rs. The rustfmt aspect lists
# every globbed file, so without this tag `//rust:rustfmt` checks them and
# `//rust:format` reformats them. `norustfmt` is the spelling both honour.
rust_library(
    name = "generated_v1",
    srcs = ["lib.rs"] + glob(["gen/**/*.rs"]),
    crate_name = "scheda_api",
    tags = ["norustfmt"],
    visibility = ["//visibility:public"],
    deps = _API_DEPS,
)

rust_test(
    name = "generated_v1_test",
    size = "small",
    crate = ":generated_v1",
    visibility = ["//rust:__pkg__"],
)

# The traits of both forms, the bridges, the `Validate` rules.
rust_test(
    name = "contract_test",
    size = "small",
    srcs = ["tests/contract.rs"],
    crate_root = "tests/contract.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":generated_v1",
        "@scheda_cargo//:buffa",
        "@scheda_cargo//:buffa-types",
        "@scheda_cargo//:protocontract",
        "@scheda_cargo//:protovalidate-buffa",
        "@scheda_cargo//:serde_json",
    ],
)

# Every proto field named `version` must be field number 1 (`int32 version = 2` fails).
rust_test(
    name = "version_field_test",
    size = "small",
    srcs = ["tests/version_field.rs"],
    crate_root = "tests/version_field.rs",
    data = ["//api:protos"],
    visibility = ["//rust:__pkg__"],
)

# No name of the contract (message, field, enum, value, service, rpc) carries a git term.
rust_test(
    name = "git_terms_test",
    size = "small",
    srcs = ["tests/git_terms.rs"],
    crate_root = "tests/git_terms.rs",
    data = ["//api:protos"],
    visibility = ["//rust:__pkg__"],
)
