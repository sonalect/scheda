load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

exports_files(["Cargo.toml"])

rust_binary(
    name = "scheda",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "scheda_cli",
    visibility = ["//visibility:public"],
    deps = [
        "//rust/scheda",
        "@cargo//:clap",
        "@cargo//:mimalloc",
        "@cargo//:model2vec-rs",
        "@cargo//:serde",
        "@cargo//:serde_json",
        "@cargo//:ureq",
    ],
)

rust_test(
    name = "http_test",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "scheda_cli",
    crate_root = "src/main.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        "//rust/scheda",
        "@cargo//:clap",
        "@cargo//:mimalloc",
        "@cargo//:model2vec-rs",
        "@cargo//:serde",
        "@cargo//:serde_json",
        "@cargo//:ureq",
    ],
)

rust_test(
    name = "cli_test",
    srcs = [
        "tests/cli.rs",
        "tests/common/mod.rs",
    ],
    compile_data = glob(["src/**/*.rs"]),
    crate_root = "tests/cli.rs",
    data = [":scheda"],
    env = {
        "CARGO_BIN_EXE_scheda": "$(rootpath :scheda)",
    },
    visibility = ["//rust:__pkg__"],
    deps = [
        "//rust/scheda",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "agent_test",
    srcs = [
        "tests/agent.rs",
        "tests/common/mod.rs",
    ],
    compile_data = glob(["src/**/*.rs"]),
    crate_root = "tests/agent.rs",
    data = [":scheda"],
    env = {
        "CARGO_BIN_EXE_scheda": "$(rootpath :scheda)",
    },
    visibility = ["//rust:__pkg__"],
    deps = [
        "//rust/scheda",
        "@cargo//:serde_json",
    ],
)
