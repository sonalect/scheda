load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")
load("//bazel:rustdoc_pages.bzl", "rustdoc_pages")

exports_files(["Cargo.toml"])

# Matches Cargo.toml [features] default. `openmp` is Cargo-only (needs libomp).
_SCHEDA_FEATURES = [
    "remote-git",
    "numkong",
]

rust_library(
    name = "scheda",
    srcs = glob(["src/**/*.rs"]),
    crate_features = _SCHEDA_FEATURES,
    crate_name = "scheda",
    visibility = ["//visibility:public"],
    deps = [
        "//rust/generated:generated_v1",
        "@cargo//:git2",
        "@cargo//:regex",
        "@cargo//:serde",
        "@cargo//:serde_json",
        "@cargo//:tantivy",
        "@cargo//:usearch",
        "@cargo//:yaml_serde",
    ],
)

rust_test(
    name = "core_test",
    srcs = ["tests/core.rs"],
    compile_data = glob([
        "src/**/*.rs",
        "testdata/**",
    ]),
    crate_root = "tests/core.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "document_test",
    srcs = ["tests/document.rs"],
    compile_data = glob(["testdata/**"]),
    crate_root = "tests/document.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "query_test",
    srcs = ["tests/query.rs"],
    compile_data = glob(["testdata/**"]),
    crate_root = "tests/query.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:serde_json",
    ],
)

rust_test(
