load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")
load("//bazel:rustdoc_pages.bzl", "rustdoc_pages")

exports_files(["Cargo.toml"])

# Full CI build (`index` + `encrypt`). Cargo turns `index` on by default;
# Bazel lists every feature it builds.
_SCHEDA_FEATURES = [
    "index",
    "encrypt",
]

# Cargo's `--no-default-features`: no feature at all. No Lance.
_SCHEDA_THIN_FEATURES = []

_SCHEDA_SRCS = glob(["src/**/*.rs"])

_SCHEDA_DEPS = [
    "//rust/api:generated_v1",
    "//rust/blocking",
    "@scheda_cargo//:buffa",
    "@scheda_cargo//:buffa-types",
    "@scheda_cargo//:git2",
    "@scheda_cargo//:libgit2-sys",
    "@scheda_cargo//:protocontract",
    "@scheda_cargo//:protovalidate-buffa",
    "@scheda_cargo//:regex",
    "@scheda_cargo//:serde",
    "@scheda_cargo//:serde_ignored",
    "@scheda_cargo//:serde_json",
    "@scheda_cargo//:tokio",
    "@scheda_cargo//:yaml_serde",
]

rust_library(
    name = "scheda",
    srcs = _SCHEDA_SRCS,
    crate_features = _SCHEDA_FEATURES,
    crate_name = "scheda",
    visibility = ["//visibility:public"],
    deps = _SCHEDA_DEPS + [
        "@scheda_cargo//:age",
        "@scheda_cargo//:futures-util",
        "@scheda_cargo//:lance",
        "@scheda_cargo//:lance-index",
        "@scheda_cargo//:lance-linalg",
    ],
)

rust_library(
    name = "scheda_thin",
    srcs = _SCHEDA_SRCS,
    crate_features = _SCHEDA_THIN_FEATURES,
    crate_name = "scheda",
    visibility = ["//rust:__pkg__"],
    deps = _SCHEDA_DEPS,
)

rust_test(
    name = "scheda_test",
    size = "small",
    compile_data = glob(["testdata/**"]),
    crate = ":scheda",
    crate_features = _SCHEDA_FEATURES,
    visibility = ["//rust:__pkg__"],
)

rust_test(
    name = "scheda_thin_test",
    size = "small",
    compile_data = glob(["testdata/**"]),
    crate = ":scheda_thin",
    crate_features = _SCHEDA_THIN_FEATURES,
    visibility = ["//rust:__pkg__"],
)

# The integration tests: one binary, so the library (and Lance) is linked
# once per build.
_INTEGRATION_SRCS = glob(["tests/integration/**/*.rs"])

_INTEGRATION_DEPS = [
    "@scheda_cargo//:buffa-types",
    "@scheda_cargo//:git2",
    "@scheda_cargo//:protocontract",
    "@scheda_cargo//:serde_json",
    "@scheda_cargo//:tokio",
]

rust_test(
    name = "integration_test",
    size = "small",
    srcs = _INTEGRATION_SRCS,
    crate_features = _SCHEDA_FEATURES,
    crate_root = "tests/integration/main.rs",
    visibility = ["//rust:__pkg__"],
    deps = [":scheda"] + _INTEGRATION_DEPS,
)

rust_test(
    name = "integration_thin_test",
    size = "small",
    srcs = _INTEGRATION_SRCS,
    crate_root = "tests/integration/main.rs",
    visibility = ["//rust:__pkg__"],
    deps = [":scheda_thin"] + _INTEGRATION_DEPS,
)

rust_doc(
    name = "scheda_doc",
    crate = ":scheda",
    crate_features = _SCHEDA_FEATURES,
)

rust_doc_test(
    name = "scheda_doc_test",
    size = "small",
    crate = ":scheda",
    crate_features = _SCHEDA_FEATURES,
)

rustdoc_pages(
    name = "pages",
    doc = ":scheda_doc",
)
