load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "scheda",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "scheda",
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    version = "0.0.1",
    visibility = ["//visibility:public"],
    deps = ["@cargo//:thiserror"],
)

rust_test(
    name = "scheda_test",
    crate = ":scheda",
    rustc_flags = ["-Dwarnings"],
)
