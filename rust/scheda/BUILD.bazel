load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")
load("//bazel:rustdoc_pages.bzl", "rustdoc_pages")

exports_files(["Cargo.toml"])

# Full CI build (`find` + `search` + SIMD). The crate has no default
# features. `openmp` is Cargo-only (needs libomp).
_SCHEDA_FEATURES = [
    "find",
    "search",
    "simd",
    "encrypt",
]

# Matches Cargo.toml [features]: no feature at all. No Tantivy, USearch, or C++.
_SCHEDA_THIN_FEATURES = []

# Shared by every integration test crate (`mod common`).
_TEST_COMMON = [
    "tests/common/mod.rs",
]

_SCHEDA_SRCS = glob(["src/**/*.rs"])

_SCHEDA_DEPS = [
    "//rust/generated:generated_v1",
    "@scheda_cargo//:buffa",
    "@scheda_cargo//:buffa-types",
    "@scheda_cargo//:regex",
    "@scheda_cargo//:serde",
    "@scheda_cargo//:serde_json",
    "@scheda_cargo//:sha2",
    "@scheda_cargo//:yaml_serde",
]

rust_library(
    name = "scheda",
    srcs = _SCHEDA_SRCS,
    crate_features = _SCHEDA_FEATURES,
    crate_name = "scheda",
    visibility = ["//visibility:public"],
    deps = _SCHEDA_DEPS + [
        "@scheda_cargo//:age",
        "@scheda_cargo//:cxx",
        "@scheda_cargo//:sha1",
        "@scheda_cargo//:tantivy",
        "@scheda_cargo//:usearch",
    ],
)

rust_library(
    name = "scheda_thin",
    srcs = _SCHEDA_SRCS,
    crate_features = _SCHEDA_THIN_FEATURES,
    crate_name = "scheda",
    visibility = ["//rust:__pkg__"],
    deps = _SCHEDA_DEPS,
)

