load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")
load("//bazel:rustdoc_pages.bzl", "rustdoc_pages")

exports_files(["Cargo.toml"])

rust_library(
    name = "scheda",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "scheda",
    visibility = ["//visibility:public"],
    deps = [
        "//rust/generated:generated_v1",
        "@cargo//:git2",
        "@cargo//:regex",
        "@cargo//:serde",
        "@cargo//:serde_json",
        "@cargo//:yaml_serde",
    ],
)

rust_test(
    name = "document_test",
    srcs = ["tests/document.rs"],
    compile_data = glob(["testdata/**"]),
    crate_root = "tests/document.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "query_test",
    srcs = ["tests/query.rs"],
    compile_data = glob(["testdata/**"]),
    crate_root = "tests/query.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "git_test",
    srcs = ["tests/git.rs"],
    compile_data = glob(["testdata/**"]),
    crate_root = "tests/git.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:git2",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "remote_test",
    srcs = ["tests/remote.rs"],
    compile_data = glob(["testdata/**"]),
    crate_root = "tests/remote.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:git2",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "scheda_test",
    compile_data = glob(["testdata/**"]),
    crate = ":scheda",
)

rust_test(
    name = "journal_test",
    srcs = ["tests/journal.rs"],
    compile_data = glob(["testdata/**"]),
    crate_root = "tests/journal.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "schema_test",
    srcs = ["tests/schema.rs"],
    compile_data = glob(["testdata/**"]),
    crate_root = "tests/schema.rs",
    visibility = ["//rust:__pkg__"],
    deps = [":scheda"],
)

rust_doc(
    name = "scheda_doc",
    crate = ":scheda",
)

rust_doc_test(
    name = "scheda_doc_test",
    size = "small",
    crate = ":scheda",
)

rustdoc_pages(
    name = "pages",
    doc = ":scheda_doc",
)
