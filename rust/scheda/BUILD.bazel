    crate_root = "tests/git.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:git2",
        "@cargo//:serde_json",
    ],
)

rust_test(
    name = "ann_test",
    srcs = ["tests/ann.rs"],
    crate_root = "tests/ann.rs",
    visibility = ["//rust:__pkg__"],
    deps = [":scheda"],
)

rust_test(
    name = "ops_test",
