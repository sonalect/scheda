load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")
load("//bazel:rustdoc_pages.bzl", "rustdoc_pages")

exports_files(["Cargo.toml"])

# Full CI build (`find` + `search` + SIMD + the async API). The crate has
# no default features. `openmp` is Cargo-only (needs libomp).
_SCHEDA_FEATURES = [
    "find",
    "search",
    "simd",
    "encrypt",
    "tokio",
]

# Matches Cargo.toml [features]: no feature at all. No Tantivy, USearch, or C++.
_SCHEDA_THIN_FEATURES = []

# Shared by every integration test crate (`mod common`).
_TEST_COMMON = [
    "tests/common/mod.rs",
]

# `src/old/` is the material of the layers not built yet; it is not compiled.
_SCHEDA_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/old/**"],
)

_SCHEDA_DEPS = [
    "//rust/api:generated_v1",
    "@scheda_cargo//:buffa",
    "@scheda_cargo//:buffa-types",
    "@scheda_cargo//:protocontract",
    "@scheda_cargo//:protovalidate-buffa",
    "@scheda_cargo//:regex",
    "@scheda_cargo//:serde",
    "@scheda_cargo//:serde_ignored",
    "@scheda_cargo//:serde_json",
    "@scheda_cargo//:sha2",
    "@scheda_cargo//:yaml_serde",
]

rust_library(
    name = "scheda",
    srcs = _SCHEDA_SRCS,
    crate_features = _SCHEDA_FEATURES,
    crate_name = "scheda",
    visibility = ["//visibility:public"],
    deps = _SCHEDA_DEPS + [
        "@scheda_cargo//:age",
        "@scheda_cargo//:cxx",
        "@scheda_cargo//:sha1",
        "@scheda_cargo//:tantivy",
        "@scheda_cargo//:tokio",
        "@scheda_cargo//:usearch",
    ],
)

rust_library(
    name = "scheda_thin",
    srcs = _SCHEDA_SRCS,
    crate_features = _SCHEDA_THIN_FEATURES,
    crate_name = "scheda",
    visibility = ["//rust:__pkg__"],
    deps = _SCHEDA_DEPS,
)

rust_test(
    name = "scheda_test",
    size = "small",
    compile_data = glob(["testdata/**"]),
    crate = ":scheda",
    crate_features = _SCHEDA_FEATURES,
)

rust_test(
    name = "scheda_thin_test",
    size = "small",
    compile_data = glob(["testdata/**"]),
    crate = ":scheda_thin",
    crate_features = _SCHEDA_THIN_FEATURES,
    visibility = ["//rust:__pkg__"],
)

rust_test(
    name = "open_test",
    size = "small",
    srcs = ["tests/open.rs"] + _TEST_COMMON,
    crate_features = _SCHEDA_FEATURES,
    crate_root = "tests/open.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@scheda_cargo//:serde_json",
    ],
)

rust_test(
    name = "open_thin_test",
    size = "small",
    srcs = ["tests/open.rs"] + _TEST_COMMON,
    crate_root = "tests/open.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda_thin",
        "@scheda_cargo//:serde_json",
    ],
)

rust_doc(
    name = "scheda_doc",
    crate = ":scheda",
    crate_features = _SCHEDA_FEATURES,
)

rust_doc_test(
    name = "scheda_doc_test",
    size = "small",
    crate = ":scheda",
    crate_features = _SCHEDA_FEATURES,
)

rustdoc_pages(
    name = "pages",
    doc = ":scheda_doc",
)
