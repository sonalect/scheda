rust_test(
    name = "scheda_test",
    compile_data = glob(["testdata/**"]),
    crate = ":scheda",
    crate_features = _SCHEDA_FEATURES,
)

rust_test(
    name = "journal_test",
    srcs = ["tests/journal.rs"],
    compile_data = glob(["testdata/**"]),
