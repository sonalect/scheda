rust_test(
    name = "catalog_test",
    srcs = ["tests/catalog.rs"],
    compile_data = glob([
        "src/**/*.rs",
        "testdata/**",
    ]),
    crate_root = "tests/catalog.rs",
    visibility = ["//rust:__pkg__"],
    deps = [
        ":scheda",
        "@cargo//:serde_json",
    ],
