exports_files(["Cargo.toml"])

# Full CI build (`find` + `search` + SIMD). Cargo default is `remote-git`
# only. `openmp` is Cargo-only (needs libomp).
_SCHEDA_FEATURES = [
    "find",
    "search",
    "simd",
    "remote-git",
    "encrypt",
]

# Matches Cargo.toml [features] default. No Tantivy, USearch, or C++.
_SCHEDA_THIN_FEATURES = [
    "remote-git",
]

_SCHEDA_SRCS = glob(["src/**/*.rs"])

_SCHEDA_DEPS = [
    "//rust/generated:generated_v1",
    "@cargo//:buffa",
    "@cargo//:buffa-types",
    "@cargo//:git2",
    "@cargo//:regex",
    "@cargo//:serde",
    "@cargo//:serde_json",
    "@cargo//:sha2",
    "@cargo//:yaml_serde",
]

rust_library(
    name = "scheda",
    srcs = _SCHEDA_SRCS,
    crate_features = _SCHEDA_FEATURES,
    crate_name = "scheda",
    visibility = ["//visibility:public"],
    deps = _SCHEDA_DEPS + [
        "@cargo//:age",
        "@cargo//:cxx",
        "@cargo//:tantivy",
        "@cargo//:usearch",
    ],
)

rust_library(
    name = "scheda_thin",
    srcs = _SCHEDA_SRCS,
    crate_features = _SCHEDA_THIN_FEATURES,
    crate_name = "scheda",
    visibility = ["//rust:__pkg__"],
    deps = _SCHEDA_DEPS,
)

