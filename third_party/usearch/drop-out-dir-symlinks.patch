+
+/// cxx-build leaves relative OUT_DIR symlinks that Bazel rejects as dangling
+/// tree-artifact children. The C++ compile already finished.
+fn drop_out_dir_symlinks(dir: &std::path::Path) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Ok(meta) = std::fs::symlink_metadata(&path) else {
+            continue;
+        };
+        if meta.file_type().is_symlink() {
+            // Unix unlink works for file and dir links. Windows directory
+            // junctions/symlinks need remove_dir; remove_file fails and
+            // Bazel then rejects dangling cxxbridge/crate/usearch.
+            if std::fs::remove_file(&path).is_err() {
+                let _ = std::fs::remove_dir(&path);
+            }
+        } else if meta.is_dir() {
+            drop_out_dir_symlinks(&path);
+        }
+    }
+}
