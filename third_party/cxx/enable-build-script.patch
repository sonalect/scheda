Scheda's crate_universe metadata used to disable cxx build.rs and attach
cc_library cxx_cc, which pulls shared libstdc++ and breaks TLS
(`__tls_get_addr`). Compile cxx.cc from build.rs and let link-cplusplus
supply the C++ stdlib.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -69,8 +69,7 @@
     visibility = ["//visibility:public"],
 )
 """
-gen_build_script = false
-link_deps = [":cxx_cc"]
+gen_build_script = true
 
 [package.metadata.bazel.extra_aliased_targets]
 cxx_cc = "cxx_cc"
