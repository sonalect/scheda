+    // ---- Audit probes (throwaway; never committed) ----
+
+    fn hold(fx: &Fixture) -> crate::fs::Flock {
+        loop {
+            if let Some(held) = fx.index().try_lock().unwrap() {
+                return held;
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+
+    /// Watches `fx` for `span`: whether the `commit` file reached `HEAD`
+    /// with no error in the status, and the last error code seen.
+    fn observe(fx: &Fixture, span: Duration) -> (bool, Option<String>, usize) {
+        let want = head(&fx.path);
+        let deadline = Instant::now() + span;
+        let mut last = None;
+        while Instant::now() < deadline {
+            let state = fx.vault.indexer().status();
+            if let Some(error) = state.last_error.as_option() {
+                last = error.code.clone();
+            }
+            let on_disk = fx.index().read_commit().unwrap().map(State::token);
+            if on_disk.as_deref() == Some(want.as_str()) && !state.last_error.is_set() {
+                return (true, last, 0);
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        (false, last, 0)
+    }
