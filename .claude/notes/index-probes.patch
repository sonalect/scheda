+    #[test]
+    fn probe_h_history_rewrite_rebuilds_only_when_the_commit_is_gone() {
+        let git = |path: &Path, args: &[&str]| {
+            let out = std::process::Command::new("git")
+                .arg("-C")
+                .arg(path)
+                .args(args)
+                .output()
+                .unwrap();
+            assert!(out.status.success(), "{args:?}: {}", String::from_utf8_lossy(&out.stderr));
+            String::from_utf8(out.stdout).unwrap().trim().to_owned()
+        };
+        let fx = Fixture::new("probe-h", &[standard("notes")]);
+        let marker = fx.index().root().join("probe-marker");
+        let wait_at = |want: &str| {
+            let deadline = Instant::now() + DEADLINE;
+            while fx.index().read_commit().unwrap().map(State::token).as_deref() != Some(want) {
+                assert!(Instant::now() < deadline, "the Index did not reach {want}");
+                std::thread::sleep(Duration::from_millis(5));
+            }
+        };
+        fx.put("notes", "a", r#"{"body":"alpha"}"#);
+        fx.built();
+        let c1 = git(&fx.path, &["rev-parse", "HEAD"]);
+        fx.put("notes", "b", r#"{"body":"beta"}"#);
+        fx.built();
+        let held = hold(&fx);
+        std::fs::write(&marker, b"x").unwrap();
+        git(&fx.path, &["reset", "--hard", &c1]);
+        drop(held);
+        wait_at(&c1);
+        eprintln!(
+            "PROBE-H reset to an older commit (object kept): rebuild ran={}",
+            !marker.exists()
+        );
+        fx.put("notes", "c", r#"{"body":"gamma"}"#);
+        fx.built();
+        let c3 = git(&fx.path, &["rev-parse", "HEAD"]);
+        let held = hold(&fx);
+        std::fs::write(&marker, b"x").unwrap();
+        git(&fx.path, &["reset", "--hard", &c1]);
+        let _ = std::fs::remove_file(fx.path.join(".git/ORIG_HEAD"));
+        eprintln!("PROBE-H refs: {}", git(&fx.path, &["for-each-ref"]));
+        git(&fx.path, &["reflog", "expire", "--expire=now", "--all"]);
+        git(&fx.path, &["gc", "--prune=now", "--quiet"]);
+        let gone = !std::process::Command::new("git")
+            .arg("-C")
+            .arg(&fx.path)
+            .args(["cat-file", "-e", &c3])
+            .status()
+            .unwrap()
+            .success();
+        eprintln!("PROBE-H indexed commit object gone after gc: {gone}");
+        fx.vault.indexer().stop().unwrap();
+        let (fresh, _items) = fx.handle(ports(&fx.projected, &fx.embedded));
+        drop(held);
+        wait_at(&c1);
+        eprintln!(
+            "PROBE-H reset + gc of the indexed commit, fresh handle: rebuild ran={}",
+            !marker.exists()
+        );
+        drop(fresh);
+    }
