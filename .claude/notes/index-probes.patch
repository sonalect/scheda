+    #[test]
+    fn probe_g_drop_waits_for_a_slow_embedder() {
+        struct Slow;
+        impl EmbedderSync for Slow {
+            fn describe(&self, _empty: Empty) -> Result<EmbedderDescriptor, Error> {
+                Ok(EmbedderDescriptor::default()
+                    .with_model_id("model-slow")
+                    .with_dimensions(DIMS as u32))
+            }
+            fn embed(
+                &self,
+                texts: BoxIter<'static, Result<Text, Error>>,
+            ) -> Result<BoxIter<'static, Result<Vector, Error>>, Error> {
+                Ok(Box::new(texts.map(|text| {
+                    std::thread::sleep(Duration::from_millis(200));
+                    Ok(Vector {
+                        values: vector_of(&text?.text.unwrap_or_default()),
+                        ..Vector::default()
+                    })
+                })))
+            }
+            fn embed_query(&self, query: Query) -> Result<Vector, Error> {
+                Ok(Vector {
+                    values: vector_of(&query.text.unwrap_or_default()),
+                    ..Vector::default()
+                })
+            }
+        }
+        let scratch = Scratch::new("probe-g");
+        let projected = Arc::new(Mutex::new(Vec::new()));
+        let ports = Ports {
+            projector: Some(ProjectorRef::from_sync(Json(projected))),
+            embedder: Some(EmbedderRef::from_sync(Slow)),
+            ..Ports::default()
+        };
+        let vault = Vault::open(scratch.0.join("vault"), options(), ports).unwrap();
+        vault
+            .create_collection(collection(standard("notes")))
+            .unwrap();
+        let path = scratch.0.join("vault").canonicalize().unwrap();
+        let held = loop {
+            if let Some(held) = Index::new(&path).try_lock().unwrap() {
+                break held;
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        };
+        for n in 0..20 {
+            vault
+                .upsert(
+                    "notes",
+                    DocumentUpsert {
+                        id: Some(format!("n{n}")),
+                        raw: Some(format!(r#"{{"body":"text {n}"}}"#).into_bytes()),
+                        note: Some("test".to_owned()),
+                        ..Default::default()
+                    },
+                )
+                .unwrap();
+        }
+        drop(held);
+        std::thread::sleep(Duration::from_millis(500));
+        let started = Instant::now();
+        drop(vault);
+        eprintln!(
+            "PROBE-G drop of the Vault 500 ms into a 4 s embedding took {:?}",
+            started.elapsed()
+        );
+    }
