+    #[test]
+    fn probe_m_check_sees_wide_modes_during_rounds() {
+        let fx = Fixture::new("probe-m", &[standard("notes")]);
+        let stop = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let found = Arc::new(Mutex::new(Vec::<String>::new()));
+        let checks = Arc::new(AtomicUsize::new(0));
+        std::thread::scope(|scope| {
+            scope.spawn(|| {
+                while !stop.load(Ordering::SeqCst) {
+                    if let Ok(problems) = crate::check::run(&fx.vault) {
+                        for problem in problems {
+                            let text = format!("{problem:?}");
+                            if text.contains("index") {
+                                found.lock().unwrap().push(text);
+                            }
+                        }
+                    }
+                    checks.fetch_add(1, Ordering::SeqCst);
+                }
+            });
+            for n in 0..150 {
+                fx.put("notes", &format!("n{n}"), &format!(r#"{{"title":"t{n}","body":"text {n}"}}"#));
+            }
+            fx.built();
+            stop.store(true, Ordering::SeqCst);
+        });
+        let found = found.lock().unwrap();
+        eprintln!(
+            "PROBE-M {} checks during 150 indexed writes: {} problems under .scheda/index; first: {:?}",
+            checks.load(Ordering::SeqCst),
+            found.len(),
+            found.first().map(|text| text.chars().take(200).collect::<String>())
+        );
+    }
