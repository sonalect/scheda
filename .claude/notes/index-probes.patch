+    #[test]
+    fn probe_f_ann_remove_and_add_growth() {
+        let ann = super::Ann::new(DIMS).unwrap();
+        let mut key = 0u64;
+        let mut live = Vec::new();
+        ann.reserve(100).unwrap();
+        for _ in 0..100 {
+            ann.add(key, &vector_of(&format!("t{key}"))).unwrap();
+            live.push(key);
+            key += 1;
+        }
+        let mut sizes = Vec::new();
+        for _ in 0..20 {
+            for k in live.drain(..) {
+                ann.remove(k).unwrap();
+            }
+            ann.reserve(100).unwrap();
+            for _ in 0..100 {
+                ann.add(key, &vector_of(&format!("t{key}"))).unwrap();
+                live.push(key);
+                key += 1;
+            }
+            let mut bytes = Vec::new();
+            ann.append_to(&mut bytes).unwrap();
+            sizes.push((ann.len(), ann.inner.capacity(), bytes.len()));
+        }
+        eprintln!("PROBE-F (len, capacity, bytes) per cycle: {sizes:?}");
+    }
