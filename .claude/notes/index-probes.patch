+    #[test]
+    fn probe_l_one_stale_collection_blocks_vector_reads_of_all() {
+        struct Shifting(Arc<std::sync::atomic::AtomicBool>);
+        impl ProjectorSync for Shifting {
+            fn describe(&self, _empty: Empty) -> Result<ProjectorDescriptor, Error> {
+                Ok(ProjectorDescriptor::default().with_projection_id("shift@1"))
+            }
+            fn columns(&self, collection: CollectionKey) -> Result<IndexSchema, Error> {
+                let mut columns = vec![column("body", ColumnKind::COLUMN_KIND_TEXT, true)];
+                if collection.name.as_deref() == Some("other")
+                    && self.0.load(std::sync::atomic::Ordering::SeqCst)
+                {
+                    columns.push(column("extra", ColumnKind::COLUMN_KIND_TEXT, false));
+                }
+                Ok(IndexSchema {
+                    columns,
+                    ..IndexSchema::default()
+                })
+            }
+            fn project(&self, document: RawDocument) -> Result<IndexDoc, Error> {
+                Json(Arc::new(Mutex::new(Vec::new()))).project(document)
+            }
+        }
+        let shifted = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let scratch = Scratch::new("probe-l");
+        let embedded = Embedded::new("model-a");
+        let ports = Ports {
+            projector: Some(ProjectorRef::from_sync(Shifting(Arc::clone(&shifted)))),
+            embedder: Some(EmbedderRef::from_sync(Counting(Arc::clone(&embedded)))),
+            ..Ports::default()
+        };
+        let vault = Vault::open(scratch.0.join("vault"), options(), ports).unwrap();
+        vault.create_collection(collection(standard("notes"))).unwrap();
+        vault.create_collection(collection(standard("other"))).unwrap();
+        let path = scratch.0.join("vault").canonicalize().unwrap();
+        let items = Items::of(&vault);
+        let put = |name: &str, id: &str, body: &str| {
+            vault
+                .upsert(
+                    name,
+                    DocumentUpsert {
+                        id: Some(id.to_owned()),
+                        raw: Some(format!(r#"{{"body":"{body}"}}"#).into_bytes()),
+                        note: Some("test".to_owned()),
+                        ..Default::default()
+                    },
+                )
+                .unwrap();
+        };
+        put("notes", "a", "alpha");
+        put("other", "o", "omega");
+        items.built(&vault, &path);
+        assert!(vault.vectors().snapshot().is_ok());
+        shifted.store(true, std::sync::atomic::Ordering::SeqCst);
+        put("notes", "b", "beta");
+        items.built(&vault, &path);
+        let stale = crate::lexical::read_stale(&Index::new(&path)).unwrap();
+        let lexical_notes = vault.lexical().snapshot(&["notes"]).map(|_| ()).map_err(|e| if e.is(VaultErrorCode::IndexStale) { "INDEX_STALE" } else { "other" });
+        let vector = vault.vectors().snapshot().map(|_| ()).map_err(|e| if e.is(VaultErrorCode::IndexStale) { "INDEX_STALE" } else { "other" });
+        eprintln!(
+            "PROBE-L stale={stale:?}; lexical read of notes: {lexical_notes:?}; vector read (any scope): {vector:?}"
+        );
+    }
