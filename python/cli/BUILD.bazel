load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("//bazel:compat.bzl", "NOT_WINDOWS")

_IMPORTS = ["../.."]

# aspect_rules_py uv host: `fail("Unsupported platform windows")`.
# Windows CI deletes this package in `.bazelrc` instead of relying on
# target_compatible_with (that still loads the BUILD file).
py_library(
    name = "cli_pkg",
    srcs = [
        "__init__.py",
        "__main__.py",
        "main.py",
    ],
    imports = _IMPORTS,
    target_compatible_with = NOT_WINDOWS,
    visibility = ["//visibility:private"],
    deps = [
        "//python:python_pkg",
        "@pypi//huggingface_hub",
    ],
)

# Same driver, three Vaults: Qwen HTTP, Jina HTTP (CC BY-NC), Model2Vec.
# `--backend` is a top-level flag so Bazel can prepend it before `import`.
[
    py_binary(
        name = name,
        srcs = ["main.py"],
        args = [
            "--backend",
            backend,
        ],
        data = ["//rust/cli:scheda"],
        imports = _IMPORTS,
        main = "main.py",
        target_compatible_with = NOT_WINDOWS,
        visibility = ["//visibility:public"],
        deps = [":cli_pkg"],
    )
    for name, backend in (
        ("cli_LLMs", "llms"),
        ("cli_jina", "jina"),
        ("cli_model2vec", "model2vec"),
    )
]
