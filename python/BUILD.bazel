load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@bazel_utils_python//:python.bzl", "ruff_format", "ruff_test", "uv_audit_test")

# Workspace-root imports so `python.vllm...` resolves.
_IMPORTS = [".."]

py_library(
    name = "python_pkg",
    srcs = ["__init__.py"],
    imports = _IMPORTS,
    visibility = ["//python:__subpackages__"],
)

ruff_test(
    name = "lint",
    size = "small",
    dirs = ["//python"],
)

ruff_format(
    name = "format",
    dirs = ["//python"],
)

uv_audit_test(
    name = "vuln",
    size = "small",
    # vllm==0.32.0 requires setuptools>=78.1.1,<81; PYSEC-2026-3447 is
    # fixed in 83.0.0 and GHSA-xmj3-9gf7-h52w in 84.1.0, which that cap
    # cannot take.
    flags = [
        "--ignore",
        "PYSEC-2026-3447",
        "--ignore",
        "GHSA-xmj3-9gf7-h52w",
    ],
)
