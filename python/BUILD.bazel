load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@bazel_utils_python//:python.bzl", "ruff_format", "ruff_test", "uv_audit_test")

# Workspace-root imports so `python.vllm...` resolves.
_IMPORTS = [".."]

py_library(
    name = "python_pkg",
    srcs = ["__init__.py"],
    imports = _IMPORTS,
    visibility = ["//python:__subpackages__"],
)

ruff_test(
    name = "lint",
    size = "small",
    dirs = ["//python"],
)

ruff_format(
    name = "format",
    dirs = ["//python"],
)

uv_audit_test(
    name = "vuln",
    size = "small",
    # vllm==0.30.0 requires setuptools>=77.0.3,<81; PYSEC-2026-3447 is
    # fixed in 83.0.0, which that cap cannot take.
    # PYSEC-2026-4319 (vllm, a denial of service in the penalty handler of
    # the local sidecars) is fixed in vllm 0.32.0, published 18 October 2026
    # 10:03 UTC: inside the two-day quarantine until 20 October 2026. Bump
    # vllm then and drop this ignore.
    flags = [
        "--ignore",
        "PYSEC-2026-3447",
        "--ignore",
        "PYSEC-2026-4319",
    ],
)
