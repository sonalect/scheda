load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@bazel_utils_buf//:buf.bzl", "buf_format", "buf_generate", "buf_lint_test", "buf_module")

filegroup(
    name = "protos",
    srcs = glob(["**/*.proto"]),
    visibility = ["//visibility:public"],
)

buf_module(
    name = "module",
    srcs = [":protos"],
    visibility = ["//visibility:public"],
    deps = [
        "//api/third_party:protobuf",
        "//api/third_party:protovalidate",
    ],
)

buf_lint_test(
    name = "lint",
    size = "small",
    module = ":module",
)

buf_format(
    name = "format",
    module = ":module",
)

buf_generate(
    name = "rust",
    module = ":module",
    template = "//:buf.gen.yaml",
)

# `bazel run //api:generate` refreshes `rust/api/gen`;
# `bazel test //api:all` fails while it differs from the plugins' output.
write_source_files(
    name = "generate",
    check_that_out_file_exists = False,
    files = {
        "//rust/api:gen": ":rust",
    },
)
