load("@bazel_utils_bazel//:bazel.bzl", "buildifier_format", "buildifier_test")
load("@bazel_utils_buf//:protoc_prefix.bzl", "protoc_prefix")
load("@bazel_utils_md//:markdown.bzl", "markdownlint_test")

buildifier_test(
    name = "lint",
    size = "small",
    exclude_patterns = [
        "./.bazel/*",
        "./.venv/*",
    ],
)

buildifier_format(
    name = "format",
    exclude_patterns = [
        "./.bazel/*",
        "./.venv/*",
    ],
)

markdownlint_test(
    name = "markdown",
    size = "small",
)

exports_files(["rustdoc_pages_index.html"])

# The prebuilt `protoc` of the proto toolchain as `bin/protoc`, with the
# well-known types Lance's protos import under `include/google/protobuf/`.
# The build scripts of the Lance crates run it through crate_universe
# annotations (`rust.MODULE.bazel`), which cannot see the root module's
# repository names, only `@@//` labels. Never `@protobuf//:protoc`: that
# target compiles protoc and the protobuf C++ library from source.
protoc_prefix(
    name = "protoc_prefix",
    visibility = ["//visibility:public"],
    wkts = [
        "@protobuf//:descriptor_proto_srcs",
        "@protobuf//:well_known_type_protos",
    ],
)

# The host under a short name: on Windows (`.bazelrc`) the output directory
# is `bazel-out/w-fastbuild`, not `bazel-out/x64_windows-fastbuild`.
platform(
    name = "host",
    parents = ["@platforms//host"],
)
