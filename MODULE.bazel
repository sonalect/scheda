"""Root Bazel module: host-only Rust library, linters, and vuln scan."""

module(
    name = "scheda",
    version = "0.18.5",
)

bazel_dep(name = "aspect_rules_py", version = "1.12.1")

# 1.12.1 host_platform_repo fail()s on Windows. Fork stamps VERSION 1.12.1 and
# BCR integrity so git_override downloads official venv/unpack/shim tools.
git_override(
    module_name = "aspect_rules_py",
    remote = "https://github.com/sonalect/rules_py.git",
    tag = "v1.12.1-windows-fix-backported-3",
)

bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_utils_bazel", version = "0.2.11")
bazel_dep(name = "bazel_utils_buf", version = "0.2.11")
bazel_dep(name = "bazel_utils_core", version = "0.2.11")
bazel_dep(name = "bazel_utils_md", version = "0.2.11")
bazel_dep(name = "bazel_utils_protoc", version = "0.2.11")
bazel_dep(name = "bazel_utils_python", version = "0.2.11")
bazel_dep(name = "bazel_utils_rust", version = "0.2.11")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "rules_rust", version = "0.74.0")

include("//:buf.MODULE.bazel")
include("//:python.MODULE.bazel")
include("//:rust.MODULE.bazel")

git_override(
    module_name = "bazel_utils_bazel",
    remote = "https://github.com/sonalect/bazel_utils.git",
    strip_prefix = "bazel",
    tag = "v0.2.11",
)

git_override(
    module_name = "bazel_utils_buf",
    remote = "https://github.com/sonalect/bazel_utils.git",
    strip_prefix = "buf",
    tag = "v0.2.11",
)

git_override(
    module_name = "bazel_utils_core",
    remote = "https://github.com/sonalect/bazel_utils.git",
    strip_prefix = "core",
    tag = "v0.2.11",
)

git_override(
    module_name = "bazel_utils_md",
    remote = "https://github.com/sonalect/bazel_utils.git",
    strip_prefix = "markdown",
    tag = "v0.2.11",
)

git_override(
    module_name = "bazel_utils_protoc",
    remote = "https://github.com/sonalect/bazel_utils.git",
    strip_prefix = "protoc",
    tag = "v0.2.11",
)

git_override(
    module_name = "bazel_utils_python",
    remote = "https://github.com/sonalect/bazel_utils.git",
    strip_prefix = "python",
    tag = "v0.2.11",
)

git_override(
    module_name = "bazel_utils_rust",
    remote = "https://github.com/sonalect/bazel_utils.git",
    strip_prefix = "rust",
    tag = "v0.2.11",
)
