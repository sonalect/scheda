"""Root Bazel module: host-only Rust library, linters, and vuln scan."""

module(
    name = "scheda",
    version = "0.9.7",
)

bazel_dep(name = "aspect_rules_py", version = "1.12.1")

# uv host fail()s on Windows; platform_libc's default is still evaluated
# for rust/proto. Stub msvc so analysis is not poisoned.
single_version_override(
    module_name = "aspect_rules_py",
    patch_strip = 1,
    patches = ["//third_party/aspect_rules_py:windows-uv-host.patch"],
    version = "1.12.1",
)

bazel_dep(name = "bazel_lib", version = "3.7.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_utils_bazel", version = "0.2.3")
bazel_dep(name = "bazel_utils_buf", version = "0.2.3")
bazel_dep(name = "bazel_utils_core", version = "0.2.3")
bazel_dep(name = "bazel_utils_md", version = "0.2.3")
bazel_dep(name = "bazel_utils_python", version = "0.2.3")
bazel_dep(name = "bazel_utils_rust", version = "0.2.3")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_rust", version = "0.74.0")

include("//:buf.MODULE.bazel")
include("//:python.MODULE.bazel")
include("//:rust.MODULE.bazel")
include("//third_party/buf/plugins/protoc-gen-buffa-packaging:crates.MODULE.bazel")
include("//third_party/buf/plugins/protoc-gen-protovalidate-buffa:crates.MODULE.bazel")

git_override(
    module_name = "bazel_utils_bazel",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "bazel",
    tag = "v0.2.3",
)

git_override(
    module_name = "bazel_utils_buf",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "buf",
    tag = "v0.2.3",
)

git_override(
    module_name = "bazel_utils_core",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "core",
    tag = "v0.2.3",
)

git_override(
    module_name = "bazel_utils_md",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "markdown",
    tag = "v0.2.3",
)

git_override(
    module_name = "bazel_utils_python",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "python",
    tag = "v0.2.3",
)

git_override(
    module_name = "bazel_utils_rust",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "rust",
    tag = "v0.2.3",
