"""Root Bazel module: host-only Rust library, linters, and vuln scan."""

module(
    name = "scheda",
    version = "0.0.1",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_utils_bazel", version = "0.2.1")
bazel_dep(name = "bazel_utils_core", version = "0.2.1")
bazel_dep(name = "bazel_utils_md", version = "0.2.1")
bazel_dep(name = "bazel_utils_rust", version = "0.2.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.73.0")

include("//:rust.MODULE.bazel")

git_override(
    module_name = "bazel_utils_bazel",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "bazel",
    tag = "v0.2.1",
)

git_override(
    module_name = "bazel_utils_core",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "core",
    tag = "v0.2.1",
)

git_override(
    module_name = "bazel_utils_md",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "markdown",
    tag = "v0.2.1",
)

git_override(
    module_name = "bazel_utils_rust",
    remote = "https://github.com/amsokol/bazel_utils.git",
    strip_prefix = "rust",
    tag = "v0.2.1",
)
