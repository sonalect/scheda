"""Rust toolchain and crate_universe for the host architecture only."""

RUST_EDITION = "2024"

# Keep in step with rust-toolchain.toml and rust-version in Cargo.toml.
RUST_VERSION = "1.99.1"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

# Host CRT on every OS.
rust.toolchain(
    edition = RUST_EDITION,
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

cargo = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

# The Lance crates compile .proto files in their build scripts with
# prost-build, which runs the `protoc` named by `PROTOC` and imports the
# well-known types from `PROTOC_INCLUDE`. Hand them the prebuilt protoc of the
# proto toolchain (`//bazel:protoc_prefix`), never `@protobuf//:protoc`: that
# target compiles protoc from source.
LANCE_PROTOC_DATA = ["@@//bazel:protoc_prefix"]

LANCE_PROTOC_ENV = {
    "PROTOC": "$(execpath @@//bazel:protoc_prefix)/bin/protoc",
    "PROTOC_INCLUDE": "$(execpath @@//bazel:protoc_prefix)/include",
}

cargo.annotation(
    build_script_data = LANCE_PROTOC_DATA,
    build_script_env = LANCE_PROTOC_ENV,
    crate = "lance",
    repositories = ["scheda_cargo"],
)
cargo.annotation(
    build_script_data = LANCE_PROTOC_DATA,
    build_script_env = LANCE_PROTOC_ENV,
    crate = "lance-datafusion",
    repositories = ["scheda_cargo"],
)
cargo.annotation(
    build_script_data = LANCE_PROTOC_DATA,
    build_script_env = LANCE_PROTOC_ENV,
    crate = "lance-encoding",
    repositories = ["scheda_cargo"],
)
cargo.annotation(
    build_script_data = LANCE_PROTOC_DATA,
    build_script_env = LANCE_PROTOC_ENV,
    crate = "lance-file",
    repositories = ["scheda_cargo"],
)
cargo.annotation(
    build_script_data = LANCE_PROTOC_DATA,
    build_script_env = LANCE_PROTOC_ENV,
    crate = "lance-index",
    repositories = ["scheda_cargo"],
)
cargo.annotation(
    build_script_data = LANCE_PROTOC_DATA,
    build_script_env = LANCE_PROTOC_ENV,
    crate = "lance-table",
    repositories = ["scheda_cargo"],
)

# The crate ships `protocontract/v1/options.proto` under `proto/`, which the
# contract imports: `@scheda_cargo//:protocontract_protos` exposes it to buf,
# in the version of the crate the lock pins. (Its `tokio` feature, the
# `Offload` / `Blocking` bridges, is on in `scheda-api`'s `Cargo.toml`.)
cargo.annotation(
    additive_build_file_content = """\
filegroup(
    name = "protos",
    srcs = glob(["proto/**/*.proto"]),
    visibility = ["//visibility:public"],
)
""",
    crate = "protocontract",
    extra_aliased_targets = {"protocontract_protos": "protos"},
    repositories = ["scheda_cargo"],
)
cargo.from_cargo(
    name = "scheda_cargo",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = [
        "//:Cargo.toml",
    ],
)
use_repo(cargo, "scheda_cargo")
