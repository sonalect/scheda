"""Rust toolchain and crate_universe for the host architecture only."""

RUST_EDITION = "2024"

RUST_VERSION = "1.98.1"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

# Host CRT on every OS. +crt-static on Linux blocked git2 OpenSSL/libssh2
# and USearch/cxx TLS; macOS/Windows never used it.
rust.toolchain(
    edition = RUST_EDITION,
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

cargo = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

include("//third_party/buf/plugins/protoc-gen-buffa-packaging:crates.MODULE.bazel")
include("//third_party/buf/plugins/protoc-gen-protovalidate-buffa:crates.MODULE.bazel")

# USearch compiles C++ via cxx-build. Bazel injects CXX=gcc on Linux unless we
# pin /usr/bin/c++. Do not set CXX on macOS: cargo_build_script already passes
# Apple CXXFLAGS with __BAZEL_XCODE_SDKROOT__, which only Bazel's clang wrapper
# expands; a raw /usr/bin/c++ then fails to find <algorithm>. Windows uses MSVC
# (no CXX override). Patches: drop dangling OUT_DIR symlinks after the C++
# compile; write rust/cxx.h into OUT_DIR when DEP_CXXBRIDGE1_HEADER is outside
# the sandbox (shared scratch dir is best-effort — WSL linux-sandbox remounts
# it EROFS; always a regular file on Windows — MSVC cannot follow the symlink);
# cxx must run build.rs (not cc_library cxx_cc) so libstdc++ TLS still links.
# numkong SIMD: copy headers into OUT_DIR so DEP_NUMKONG_INCLUDE is visible to
# usearch's sandboxed C++ compile.
cargo.annotation(
    crate = "cxx",
    gen_build_script = "on",
    patch_args = ["-p1"],
    patches = ["//third_party/cxx:enable-build-script.patch"],
    repositories = ["cargo"],
)
cargo.annotation_select(
    build_script_env = {
        "CXX": "/usr/bin/c++",
    },
    crate = "cxx",
    repositories = ["cargo"],
    triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
cargo.annotation(
    crate = "cxx-build",
    patch_args = ["-p1"],
    patches = ["//third_party/cxx:cxx-build-header-fallback.patch"],
    repositories = ["cargo"],
)
cargo.annotation(
    crate = "numkong",
    patch_args = ["-p1"],
    patches = ["//third_party/numkong:include-to-outdir.patch"],
    repositories = ["cargo"],
)
cargo.annotation(
    crate = "usearch",
    patch_args = ["-p1"],
    patches = ["//third_party/usearch:drop-out-dir-symlinks.patch"],
    repositories = ["cargo"],
)
cargo.annotation_select(
    build_script_env = {
        "CXX": "/usr/bin/c++",
    },
    crate = "usearch",
    repositories = ["cargo"],
    triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)

# Optional `age` for scheda `encrypt`. `age` is an optional dependency behind
# the non-default `encrypt` feature, so `from_cargo` never materializes an
# alias for it, and without the tag `@cargo//:age` is not a target at all
# (`bazel query` answers "no such target"). Restrict to the `cargo` hub: a
# spec with no `repositories` is a common spec on every hub.
cargo.spec(
    default_features = False,
    features = ["armor"],
    package = "age",
    repositories = ["cargo"],
    version = "=0.12.1",
)
cargo.from_cargo(
    name = "cargo",
    cargo_lockfile = "//:Cargo.lock",
    generate_binaries = True,
    manifests = [
        "//:Cargo.toml",
    ],
)
use_repo(cargo, "cargo")
