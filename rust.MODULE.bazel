"""Rust toolchain and crate_universe for the host architecture only."""

RUST_EDITION = "2024"

RUST_VERSION = "1.98.1"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

# Host CRT on every OS. +crt-static on Linux blocked git2 OpenSSL/libssh2
# and USearch/cxx TLS; macOS/Windows never used it.
rust.toolchain(
    edition = RUST_EDITION,
    versions = [RUST_VERSION],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

cargo = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

# USearch compiles C++ via cxx-build. Bazel injects CXX=gcc on Linux unless we
# pin /usr/bin/c++. Do not set CXX on macOS: cargo_build_script already passes
# Apple CXXFLAGS with __BAZEL_XCODE_SDKROOT__, which only Bazel's clang wrapper
# expands; a raw /usr/bin/c++ then fails to find <algorithm>. Windows uses MSVC
# (no CXX override). cxx/cxx-build come from 1.0.202-bazel-sandbox-fix-2
# (sandbox HEADER + no-op subcrate build.rs). numkong comes from
# v7.8.2-bazel-sandbox-fix (headers copied into OUT_DIR). usearch comes
# from v2.26.2-bazel-sandbox-fix (drop dangling OUT_DIR symlinks).
cargo.annotation(
    crate = "cxx",
    gen_build_script = "on",
    repositories = ["cargo"],
)
cargo.annotation_select(
    build_script_env = {
        "CXX": "/usr/bin/c++",
    },
    crate = "cxx",
    repositories = ["cargo"],
    triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
cargo.annotation_select(
    build_script_env = {
        "CXX": "/usr/bin/c++",
    },
    crate = "usearch",
    repositories = ["cargo"],
    triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)

# Optional `age` for scheda `encrypt`. `age` is an optional dependency behind
# the non-default `encrypt` feature, so `from_cargo` never materializes an
# alias for it, and without the tag `@cargo//:age` is not a target at all
# (`bazel query` answers "no such target"). Restrict to the `cargo` hub: a
# spec with no `repositories` is a common spec on every hub.
cargo.spec(
    default_features = False,
    features = ["armor"],
    package = "age",
    repositories = ["cargo"],
    version = "=0.12.1",
)

# Binary plugin for buf generate. crates.io 0.9.2 is bin-only; the fork
# tag adds an empty [lib] so crate_universe generate_binaries can emit it.
# Spec on this hub (not a dummy crate) so there is no third_party pin pkg.
cargo.spec(
    git = "https://github.com/amsokol/buffa",
    package = "protoc-gen-buffa-packaging",
    repositories = ["cargo"],
    tag = "v0.9.2-bazel-packaging",
)

# Plugin already has a [lib]; fork tag so generate_binaries can emit it
# without a dummy crate. protovalidate-buffa-protos is generated (no PROTOC).
cargo.spec(
    git = "https://github.com/amsokol/protovalidate-buffa",
    package = "protoc-gen-protovalidate-buffa",
    repositories = ["cargo"],
    tag = "protoc-gen-protovalidate-buffa-v0.10.0",
)
cargo.from_cargo(
    name = "cargo",
    cargo_lockfile = "//:Cargo.lock",
    generate_binaries = True,
    manifests = [
        "//:Cargo.toml",
    ],
)
use_repo(cargo, "cargo")
